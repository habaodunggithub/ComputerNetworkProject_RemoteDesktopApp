{
  "name": "gateway-remote",
  "version": "1.0.0",
  "description": "Remote Control Gateway",
  "main": "gateway.js",
  "bin": "gateway.js",
  "scripts": {
    "start": "node gateway.js",
    "build": "pkg . --targets node18-win-x64 --output gateway.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "better_sqlite3.node"
    ],
    "outputPath": "."
  },
  "dependencies": {
    "better-sqlite3": "^11.0.0",
    "express": "^4.18.2",
    "ws": "^8.13.0"
  }
}