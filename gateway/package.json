{
  "name": "gateway-remote",
  "version": "1.0.0",
  "description": "Remote Control Gateway",
  "license": "MIT",
  "main": "gateway.js",
  "bin": "gateway.js",
  "scripts": {
    "start": "node gateway.js",
    "build": "pkg . --targets node18-win-x64 --output gateway.exe"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "node_modules/sql.js/dist/sql-wasm.wasm"
    ],
    "outputPath": "."
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "body-parser": "^2.2.1",
    "express": "^4.18.2",
    "sql.js": "^1.13.0",
    "ws": "^8.13.0"
  }
}
